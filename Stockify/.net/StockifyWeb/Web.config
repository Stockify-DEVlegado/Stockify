   <endpoint address="http://localhost:8080/StockifyWS/UsuarioWS"
    binding="basicHttpBinding" bindingConfiguration="UsuarioWSPortBinding"
    contract="StockifyWS.UsuarioWS" name="UsuarioWSPort" />
   <endpoint address="http://localhost:8080/StockifyWS/OrdenSalidaWS"
    binding="basicHttpBinding" bindingConfiguration="OrdenSalidaWSPortBinding"
    contract="StockifyWS.OrdenSalidaWS" name="OrdenSalidaWSPort" />
   <endpoint address="http://localhost:8080/StockifyWS/LineaOrdenVentaWS"
    binding="basicHttpBinding" bindingConfiguration="LineaOrdenVentaWSPortBinding"
    contract="StockifyWS.LineaOrdenVentaWS" name="LineaOrdenVentaWSPort" />
