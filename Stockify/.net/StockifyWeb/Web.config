   <endpoint address="http://localhost:8080/StockifyWS/MovimientoWS"
    binding="basicHttpBinding" bindingConfiguration="MovimientoWSPortBinding"
    contract="StockifyWS.MovimientoWS" name="MovimientoWSPort" />
   <endpoint address="http://localhost:8080/StockifyWS/ProductoWS"
    binding="basicHttpBinding" bindingConfiguration="ProductoWSPortBinding"
    contract="StockifyWS.ProductoWS" name="ProductoWSPort" />
   <endpoint address="http://localhost:8080/StockifyWS/LineaOrdenCompraWS"
    binding="basicHttpBinding" bindingConfiguration="LineaOrdenCompraWSPortBinding"
