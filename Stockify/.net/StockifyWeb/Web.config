   <endpoint address="http://localhost:8080/StockifyWS/EmpresaWS"
    binding="basicHttpBinding" bindingConfiguration="EmpresaWSPortBinding"
    contract="StockifyWS.EmpresaWS" name="EmpresaWSPort" />
  </client>
	</system.serviceModel>
