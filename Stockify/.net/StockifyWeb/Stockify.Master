<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Stockify.master.cs" Inherits="StockifyWeb.Stockify" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Stockify</title>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        html, body { 
            height: 100%; 
            margin: 0;
            overflow: hidden;
        }
        
        body { background: #000; }

        .container-fluid {
            height: 100vh;
            overflow: hidden;
        }

        #bdSidebar {
            width: 220px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 1000;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 220px;
            width: calc(100% - 220px);
            height: 100vh;
            overflow-x: auto;
            overflow-y: auto;
        }

        .content-wrapper {
            min-width: 1200px;
            padding: 1.5rem;
        }

        .mynav .nav-item a {
            color: white;
            text-decoration: none;
            padding: 10px 15px;
            display: block;
            border-radius: 5px;
        }
        
        .mynav .nav-item a:hover {
            background-color: rgba(255,255,255,0.1);
        }
        
        .mynav .nav-item a.active,
        .mynav .nav-item a.active.text-white {
            color: #b6ff00 !important;
            font-weight: 500;
        }
        
        .mynav .nav-item a.active i,
        .mynav .nav-item a.active.text-white i {
            color: #b6ff00 !important;
        }

        .user-menu-sidebar {
            margin-top: auto;
            padding: 20px 0;
        }

        svg, img, canvas {
            max-width: 100%;
            height: auto;
        }

        /* Estilos del botón de notificaciones */
        .notification-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1100;
            background: #21252d;
            border: 1px solid #323844;
            color: #e7eaf0;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 12px rgba(0,0,0,.4);
        }

        .notification-btn:hover {
            background: #2a2f39;
            transform: scale(1.05);
        }

        .notification-btn i {
            font-size: 20px;
        }

        .notification-badge {
            position: absolute;
            top: 5px;
            right: 5px;
            background: #ff6b6b;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* Panel de notificaciones */
        .notifications-panel {
            position: fixed;
            top: 0;
            right: -400px;
            width: 400px;
            height: 100vh;
            background: #0b0c0f;
            border-left: 1px solid #323844;
            z-index: 1050;
            transition: right 0.3s ease;
            display: flex;
            flex-direction: column;
            box-shadow: -5px 0 20px rgba(0,0,0,.5);
        }

        .notifications-panel.open {
            right: 0;
        }

        .notifications-header {
            padding: 20px;
            border-bottom: 1px solid #323844;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #21252d;
        }

        .notifications-header h3 {
            color: #e7eaf0;
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

        .close-notifications {
            background: none;
            border: none;
            color: #a9b3c7;
            font-size: 24px;
            cursor: pointer;
            padding: 0;
            width: 30px;
            height: 30px;
        }

        .close-notifications:hover {
            color: #e7eaf0;
        }

        .notifications-actions {
            padding: 10px 20px;
            border-bottom: 1px solid #323844;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .mark-all-read {
            background: none;
            border: none;
            color: #8aa2ff;
            font-size: 13px;
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 5px;
            transition: all 0.3s;
        }

        .mark-all-read:hover {
            background: #21252d;
        }

        .notifications-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
        }

        .notification-item {
            background: #21252d;
            border: 1px solid #323844;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }

        .notification-item:hover {
            background: #2a2f39;
            border-color: #8aa2ff;
        }

        .notification-item.unread {
            border-left: 4px solid #8aa2ff;
        }

        .notification-item.unread::before {
            content: '';
            position: absolute;
            top: 15px;
            right: 15px;
            width: 8px;
            height: 8px;
            background: #8aa2ff;
            border-radius: 50%;
        }

        .notification-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            margin-right: 12px;
            font-size: 16px;
        }

        .notification-item.success .notification-icon {
            background: rgba(75, 192, 75, 0.2);
            color: #4bc04b;
        }

        .notification-item.info .notification-icon {
            background: rgba(138, 162, 255, 0.2);
            color: #8aa2ff;
        }

        .notification-item.warning .notification-icon {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
        }

        .notification-item.error .notification-icon {
            background: rgba(255, 107, 107, 0.2);
            color: #ff6b6b;
        }

        .notification-content {
            flex: 1;
        }

        .notification-message {
            color: #e7eaf0;
            font-size: 14px;
            margin-bottom: 5px;
            line-height: 1.4;
        }

        .notification-time {
            color: #a9b3c7;
            font-size: 12px;
        }

        .no-notifications {
            text-align: center;
            padding: 40px 20px;
            color: #a9b3c7;
        }

        .no-notifications i {
            font-size: 48px;
            margin-bottom: 15px;
            opacity: 0.5;
        }

        .no-notifications p {
            margin: 0;
            font-size: 14px;
        }

        /* Overlay para cerrar al hacer clic fuera */
        .notifications-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1040;
        }

        .notifications-overlay.open {
            display: block;
        }

        @media (max-width: 768px) {
            #bdSidebar { width: 200px; }
            .main-content { 
                margin-left: 200px; 
                width: calc(100% - 200px); 
            }
            .notifications-panel {
                width: 100%;
                right: -100%;
            }
        }
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        
        <div class="container-fluid d-flex p-0">
            <!-- Barra Lateral -->
            <div id="bdSidebar" class="d-flex flex-column flex-shrink-0 p-3 bg-dark text-white">
                <a href="Inicio.aspx" class="navbar-brand">
                    <img src="Images/stockify-logo.png" width="150" alt="Logo Stockify">
                </a>
                <hr>
                <ul class="mynav nav nav-pills flex-column mb-auto">
                    <li class="nav-item mb-1">
                        <a href="Inicio.aspx" class="nav-link text-white">
                            <i class="fa-solid fa-home pe-2"></i> Inicio
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a href="Inventario.aspx" class="nav-link text-white">
                            <i class="fa-solid fa-boxes pe-2"></i> Inventario
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a href="Reportes.aspx" class="nav-link text-white">
                            <i class="fa-solid fa-chart-bar pe-2"></i> Reportes
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a href="Proveedores.aspx" class="nav-link text-white">
                            <i class="fa-solid fa-truck pe-2"></i> Proveedores
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a href="Ordenes.aspx" class="nav-link text-white">
                            <i class="fa-solid fa-file-invoice pe-2"></i> Órdenes
                        </a>
                    </li>
                </ul>
                
                <div class="user-menu-sidebar">
                    <div class="text-white text-center mb-2 small">
                        <asp:Label ID="lblUsuario" runat="server" Text="Usuario"></asp:Label>
                    </div>
                    <div class="d-grid">
                        <asp:LinkButton ID="btnCerrarSesion" 
                                       runat="server" 
                                       CssClass="btn border-0 text-white bg-dark bg-opacity-25" 
                                       OnClick="btnCerrarSesion_Click">
                            <i class="fas fa-sign-out-alt me-2"></i>
                            Cerrar Sesión
                        </asp:LinkButton>
                    </div>
                </div>
            </div>

            <!-- Contenido Principal -->
            <div class="main-content bg-black">
                <div class="content-wrapper">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                    <asp:ContentPlaceHolder ID="cph_Contenido" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

        <!-- Botón de Notificaciones -->
        <button type="button" class="notification-btn" onclick="toggleNotifications()">
            <i class="fas fa-bell"></i>
            <asp:Panel ID="pnlBadge" runat="server" CssClass="notification-badge" Visible="false">
                <asp:Literal ID="litBadgeCount" runat="server" />
            </asp:Panel>
        </button>

        <!-- Overlay -->
        <div class="notifications-overlay" id="notificationsOverlay" onclick="toggleNotifications()"></div>

        <!-- Panel de Notificaciones -->
        <div class="notifications-panel" id="notificationsPanel">
            <div class="notifications-header">
                <h3>
                    <i class="fas fa-bell me-2"></i>Notificaciones
                </h3>
                <button type="button" class="close-notifications" onclick="toggleNotifications()">
                    &times;
                </button>
            </div>
            
            <div class="notifications-actions">
                <span style="color: #a9b3c7; font-size: 13px;">
                    <asp:Literal ID="litTotalNotifications" runat="server" />
                </span>
                <asp:LinkButton ID="btnMarcarTodasLeidas" runat="server" 
                    CssClass="mark-all-read" 
                    OnClick="btnMarcarTodasLeidas_Click"
                    Text="Marcar todas como leídas" />
            </div>
            
            <div class="notifications-list" id="notificationsList">
                <asp:Repeater ID="rptNotificaciones" runat="server">
                    <ItemTemplate>
                        <div class="notification-item <%# Eval("Tipo") %> <%# (bool)Eval("Leida") ? "" : "unread" %>" 
                             onclick='marcarComoLeida(<%# Eval("Id") %>)'>
                            <div style="display: flex; align-items: start;">
                                <div class="notification-icon">
                                    <i class="fas <%# Eval("Icono") %>"></i>
                                </div>
                                <div class="notification-content">
                                    <div class="notification-message">
                                        <%# Eval("Mensaje") %>
                                    </div>
                                    <div class="notification-time">
                                        <%# GetTiempoTranscurrido((DateTime)Eval("Fecha")) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </ItemTemplate>
                </asp:Repeater>
                
                <asp:Panel ID="pnlSinNotificaciones" runat="server" CssClass="no-notifications" Visible="false">
                    <i class="fas fa-bell-slash"></i>
                    <p>No tienes notificaciones</p>
                </asp:Panel>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar activo
        document.addEventListener('DOMContentLoaded', function () {
            const sidebarLinks = document.querySelectorAll('#bdSidebar .mynav .nav-item a');
            sidebarLinks.forEach(link => {
                link.addEventListener('click', function () {
                    sidebarLinks.forEach(item => item.classList.remove('active'));
                    this.classList.add('active');
                });
            });
            const currentPage = window.location.pathname.split('/').pop();
            sidebarLinks.forEach(link => {
                if (link.getAttribute('href') === currentPage) {
                    link.classList.add('active');
                }
            });
        });

        // Toggle panel de notificaciones
        function toggleNotifications() {
            const panel = document.getElementById('notificationsPanel');
            const overlay = document.getElementById('notificationsOverlay');

            panel.classList.toggle('open');
            overlay.classList.toggle('open');
        }

        // Cerrar con tecla ESC
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                const panel = document.getElementById('notificationsPanel');
                const overlay = document.getElementById('notificationsOverlay');
                if (panel.classList.contains('open')) {
                    panel.classList.remove('open');
                    overlay.classList.remove('open');
                }
            }
        });

        // Marcar notificación como leída (llamada AJAX)
        function marcarComoLeida(id) {
            __doPostBack('MarcarLeida', id);
        }
    </script>
</body>
</html>